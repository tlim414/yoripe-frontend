# ==========================================
# YORIPE FRONTEND ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to '.env' or '.env.local' and fill in your actual values.
# IMPORTANT: In Vite, all environment variables exposed to the client MUST start with 'VITE_'.

# Express Backend API Base URL
VITE_API_BASE_URL="http://localhost:5050/api"

# Clerk Authentication (Publishable Key)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key_here"